  <!-- Debug 目录是实际运行资源所在处；Release/x64 构建后自动拷入，避免缺 flashFile 等启动即崩 -->
  <Target Name="CopyRuntimeWorkingDirs" AfterTargets="Build" Condition="'$(Configuration)' != 'Debug' Or '$(Platform)' != 'AnyCPU'">
    <ItemGroup>
      <_RuntimeFlash Include="$(ProjectDir)bin\Debug\flashFile\**\*.*" Condition="Exists('$(ProjectDir)bin\Debug\flashFile')" />
      <_RuntimeConfig Include="$(ProjectDir)bin\Debug\Config\**\*.*" Condition="Exists('$(ProjectDir)bin\Debug\Config')" />
      <_RuntimeFFmpeg Include="$(ProjectDir)bin\Debug\FFmpeg\**\*.*" Condition="Exists('$(ProjectDir)bin\Debug\FFmpeg')" />
      <_RuntimePic Include="$(ProjectDir)bin\Debug\pic\**\*.*" Condition="Exists('$(ProjectDir)bin\Debug\pic')" />
      <_RuntimeMsn Include="$(ProjectDir)bin\Debug\Msn\**\*.*" Condition="Exists('$(ProjectDir)bin\Debug\Msn')" />
    </ItemGroup>
    <Copy SourceFiles="@(_RuntimeFlash)" DestinationFiles="@(_RuntimeFlash->'$(OutDir)flashFile\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_RuntimeConfig)" DestinationFiles="@(_RuntimeConfig->'$(OutDir)Config\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_RuntimeFFmpeg)" DestinationFiles="@(_RuntimeFFmpeg->'$(OutDir)FFmpeg\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_RuntimePic)" DestinationFiles="@(_RuntimePic->'$(OutDir)pic\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_RuntimeMsn)" DestinationFiles="@(_RuntimeMsn->'$(OutDir)Msn\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
